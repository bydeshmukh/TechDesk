        <script><![CDATA[(function executeRule(current, previous) {
    try {
        var requestType = current.request_type.toString();
        var groupName = '';

        if (requestType === 'hardware' || requestType === 'peripheral') {
            groupName = 'IT Hardware Team';
        } else if (requestType === 'software' || requestType === 'access') {
            groupName = 'IT Software Team';
        } else {
            groupName = 'IT Service Desk';
        }

        var gr = new GlideRecord('sys_user_group');
        gr.addQuery('name', groupName);
        gr.query();
        if (gr.next()) {
            current.assignment_group = gr.sys_id;
            gs.info('TechDesk: Auto-assigned request ' + current.number + ' to group ' + groupName);
        } else {
            gs.warn('TechDesk: Could not find group ' + groupName + ' for auto-assignment');
        }
    } catch (e) {
        gs.error('TechDesk: Error in auto-assign-group - ' + e.message);
    }
})(current, previous);
]]></script>
