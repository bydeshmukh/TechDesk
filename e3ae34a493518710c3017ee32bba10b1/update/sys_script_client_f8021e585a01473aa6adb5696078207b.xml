        <name>Show cost warning</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) {
        return;
    }

    var cost = parseFloat(newValue);

    if (cost > 5000) {
        g_form.showFieldMsg('cost_estimate', 'Requests over $5,000 require VP-level approval', 'info');
    } else {
        g_form.hideFieldMsg('cost_estimate');
    }
}
