        <script><![CDATA[function onSubmit() {
    var costEstimate = parseFloat(g_form.getValue('cost_estimate'));
    var justification = g_form.getValue('business_justification');

    if (costEstimate > 1000 && !justification) {
        g_form.showErrorBox('business_justification', 'Business justification is required for requests over $1,000');
        return false;
    }

    return true;
}
